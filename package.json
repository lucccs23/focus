{
  "name": "focus",
  "productName": "Focus",
  "version": "1.3.0",
  "description": "Pomodoro, cronômetro e estatísticas de estudo",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "runtime": "node build/make-runtime.js",
    "shortcuts": "electron build/make-shortcuts.js",
    "test": "npm run test:web && npm run test:desktop",
    "test:web": "electron tests/web.js",
    "test:desktop": "electron tests/desktop.js"
  },
  "build": {
    "appId": "com.focus.app",
    "productName": "Focus",
    "files": [
      "index.html",
      "mini.html",
      "css/**",
      "js/**",
      "electron/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Focus"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
